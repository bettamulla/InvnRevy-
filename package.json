{
  "name": "payreview",
  "version": "0.1.0",
  "private": true,
  "description": "Get paid faster. Get more reviews. A tiny tool that chases late invoices and asks for reviews on autopilot.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seed.ts",
    "cron:run": "tsx src/lib/cron-runner.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.36.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.0",
    "zod": "^3.23.8",
    "resend": "^4.0.0",
    "twilio": "^5.3.0",
    "node-cron": "^3.0.3",
    "nanoid": "^5.0.7",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node-cron": "^3.0.11",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0"
  }
